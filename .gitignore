# Editor / agent scratch (local only; not tracked). Listed explicitly rather than left
# untracked: `git status` is a review tool, and a permanently dirty one gets ignored.
.cursor/
.claude/
.obsidian/
.mypy_cache/
.ruff_cache/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# OS
.DS_Store

# Local env (docker compose / secrets)
.env
# Backups and variants hold the same secrets as .env itself; ``.env`` alone does not
# cover them, so a copy like ``.env.bak.<date>`` would otherwise show up as untracked
# and be one ``git add -A`` away from being committed.
.env.*
# Templates only — these hold placeholders, never values. Each is negated by exact name
# rather than by a pattern like `!.env.*.example`, so a real file that happens to match
# (`.env.production.example.bak`) stays ignored.
!.env.example
!.env.production.example

# Local API databases (Alembic / FastAPI dev, and the demo recording database).
# WAL/SHM sidecars (SQLite runs in WAL mode; see backend/db/session.py) and local backups.
data/*.db
data/*.db-*
data/*.db.*

# Managed artifact blobs (local object store)
data/artifact_storage/

# Durable per-run workspaces (EDGAR_BACKEND_RUN_WORKSPACE_ROOT)
data/runs/

# Benchmark *output* — `edgar_project.cli evaluate` and `demo --fixtures` rewrite these on
# every run, and they embed absolute paths from whichever machine produced them. Committing
# them meant the README's own offline commands left the working tree dirty. Shape-stable
# examples live in `examples/evaluation_*.example.json` instead.
data/evaluation/*_results.json
data/evaluation/*_summary.json
data/evaluation/*_report.md
data/evaluation/suite_*/
# Published agency measurements are the exception: dated, immutable, and cited by
# docs/agent/agency-scoreboard.md as the raw result behind each row.
!data/evaluation/agency/

# Next.js app (see frontend/.gitignore)
frontend/node_modules/
frontend/.next/

# Root-level node install (tooling); frontend has its own
node_modules/

# Impeccable design-skill state — entirely local. The critique snapshots used to be tracked
# as "design history", which meant five AI-written review files shipped in the repo where a
# reader looking for the product found tooling output instead.
.impeccable/
frontend/.impeccable/

# Database snapshots from scripts/record_demo.py --dump: every row, including
# password hashes. Never commit these.
var/
*.dump

# Local planning scratch (GSD-era roadmaps and phase notes). Tracked plans live in
# docs/decisions/; anything here is the author's working notes and stays off the repo.
.planning/
